# Copy this file to .env for local development. Never commit the copy.
#
# ---------------------------------------------------------------------------
# AI PROVIDER KEYS ARE NOT CONFIGURED HERE.
#
# The app asks for your provider key on first run and stores it in your
# operating system's credential manager (Windows Credential Manager, macOS
# Keychain, or the Linux Secret Service). That is the supported way to add a
# key, for developers as well as for everyone else:
#
#     python -m agent --providers
#
# The three variables below exist only as a convenience for working on this
# code — for example, to run the test suite against a scratch account without
# touching your real one. They are read in a source checkout only. A packaged
# build ignores them unless AGENT_ALLOW_ENV_KEYS=1 is set, so that nobody can
# inherit a developer's key by accident, and a key you configured in the app
# is never overridden by one of these.
#
# Precedence:  your stored credential  →  the variable below (dev only)  →  none
#
# Leave them empty. Never put a real key in a file that lives in this folder.
# ---------------------------------------------------------------------------

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Let a packaged build read the three variables above. Off by default and
# should stay off — see the note above.
# AGENT_ALLOW_ENV_KEYS=0

# Store provider keys in an unencrypted file when the system has no credential
# manager at all (a headless Linux box, typically). Off by default. Turning it
# on means your keys are NOT protected on disk; the app says so wherever it
# shows them. Prefer installing GNOME Keyring or KWallet.
# AGENT_ALLOW_INSECURE_KEYSTORE=0

# --- agent behaviour ---------------------------------------------------------

# Which model each provider uses is chosen in the app (--providers), not here,
# because it is a per-provider choice rather than an environment setting.

# How hard the model works per turn: low | medium | high | xhigh | max.
# Providers that have no such control ignore it. Leave unset for the default.
# AGENT_EFFORT=medium

# Ceiling on tokens per response, including reasoning. Clamped down to whatever
# the chosen model can actually emit.
AGENT_MAX_TOKENS=32000

# Show the model's reasoning as it works, on providers that return it.
# Toggle live with /thinking.
AGENT_SHOW_THINKING=false

# Skip the y/N prompt before sending mail, sharing files, deleting, and
# creating events. Leave this false unless you know you want it.
AGENT_AUTO_APPROVE=false

# Where the agent's local file tools read and write. Defaults to ./workspace
# AGENT_WORKSPACE=C:\Users\you\agent-files

# --- web search --------------------------------------------------------------

# Search works with no key at all: with nothing set below it uses DuckDuckGo,
# which needs no account. Add a key for better results and higher rate limits —
# whichever one you set is used, and DuckDuckGo stays as the fallback.
# These are search keys, not AI provider keys, and follow the ordinary
# environment-variable pattern.

# Brave Search: 2,000 queries/month free. https://brave.com/search/api/
# BRAVE_SEARCH_API_KEY=

# Tavily: built for agents, returns cleaner extracts. https://tavily.com/
# TAVILY_API_KEY=

# Google Programmable Search: 100 queries/day free. Needs both values —
# an API key from console.cloud.google.com and an engine id from
# programmablesearchengine.google.com (set it to search the entire web).
# GOOGLE_SEARCH_API_KEY=
# GOOGLE_SEARCH_ENGINE_ID=

# Force one backend instead of picking the best configured one:
# brave | tavily | google | duckduckgo
# AGENT_SEARCH_PROVIDER=brave

# --- browser automation ------------------------------------------------------

# The browser tools need Chromium, downloaded once with:
#     python -m playwright install chromium

# Run the browser invisibly. Default false — a visible window is how you see
# what it is doing, and how you sign in or clear a captcha yourself when asked.
AGENT_BROWSER_HEADLESS=false

# Ask before every click and every keystroke, not only the ones that look
# consequential (purchases, deletions, form submissions always ask).
AGENT_BROWSER_CONFIRM_ALL=false

# Restrict the browser to these hosts and their subdomains. Empty means
# anywhere. Comma-separated.
# AGENT_BROWSER_ALLOWED_DOMAINS=example.com,intranet.corp

# --- logging -----------------------------------------------------------------

# What goes into activity.log next to your .env: every search, page fetch and
# browser action. API keys are never written to it. DEBUG | INFO | WARNING |
# ERROR | OFF. Default INFO.
# AGENT_LOG_LEVEL=INFO

# =============================================================================
# THE API SERVER (server/)
#
# Everything below configures the multi-user backend, not the desktop app. A
# developer running only the desktop client against somebody else's deployment
# needs none of it except LUMEN_API_URL.
#
# None of these values ever reach a client. The one thing the desktop app is
# told is the contents of Settings.public_config(), which is a hand-written
# allowlist in server/settings.py -- adding a variable here does not publish it.
# =============================================================================

# --- which server the desktop app talks to -----------------------------------

# Read by agent/auth/session.py, and the switch that turns accounts on at all.
# Unset -- as it ships -- the desktop app has no accounts: no sign-in screen, no
# account items in the menu, nothing to sign up for, everything local to the
# machine. Set it and the app signs in to that deployment. Point it at your
# production URL there; for local development it is the line below.
# LUMEN_API_URL=http://127.0.0.1:8000

# --- environment -------------------------------------------------------------

# development | production. In production the server refuses to start unless
# HTTPS is required and every URL below is https://.
LUMEN_ENV=development

# --- Supabase ----------------------------------------------------------------
#
# From your project's dashboard: Project Settings -> API.

# https://<project-ref>.supabase.co
SUPABASE_URL=

# The publishable "anon" key. Held server-side only: the desktop app talks to
# this API and never to Supabase directly, so there is one door to rate limit.
SUPABASE_ANON_KEY=

# The service_role key. BYPASSES ROW-LEVEL SECURITY. It is used by exactly four
# things (rate limiting, OAuth token custody, audit writes, account deletion) --
# grep for `service_connection(` to see all of them. Never ship it to a client,
# never put it in a build, and rotate it if it is ever printed.
SUPABASE_SERVICE_ROLE_KEY=

# Only needed if your project still signs tokens with the legacy HS256 secret.
# Projects using asymmetric keys are verified through JWKS and can leave this
# blank -- which is preferable, because then this server holds no signing key at
# all and a compromise of it cannot mint tokens.
# SUPABASE_JWT_SECRET=

# --- database ----------------------------------------------------------------
#
# Project Settings -> Database -> Connection string. Use the *pooler* URI in
# production. Must NOT be the service_role REST endpoint: this is a direct
# Postgres connection, because RLS is applied by setting the role and the
# verified JWT claims per transaction (see server/db.py).
DATABASE_URL=

# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10
# DATABASE_STATEMENT_TIMEOUT_MS=15000

# --- token encryption --------------------------------------------------------
#
# Wraps stored OAuth tokens with AES-256-GCM before they reach Postgres, so a
# database dump alone does not yield a working Google credential.
#
# Generate one with:
#     python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
#
# LOSING THIS KEY means every stored integration has to be reconnected. Back it
# up somewhere separate from the database.
LUMEN_TOKEN_ENCRYPTION_KEY=

# Bump when rotating, and move the old key to LUMEN_TOKEN_KEYS_PREVIOUS so rows
# written under it still open while they are re-wrapped in the background.
# LUMEN_TOKEN_KEY_VERSION=1
# LUMEN_TOKEN_KEYS_PREVIOUS=1:<old base64 key>

# --- Google OAuth (integrations, not sign-in) --------------------------------
#
# A *Web application* client, not the Desktop one in credentials/. The two are
# separate on purpose: the desktop client authorises the app on one machine,
# this one authorises the server to act for a signed-in user.
#
# Authorised redirect URI must be exactly:
#     <LUMEN_PUBLIC_URL>/api/integrations/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- URLs --------------------------------------------------------------------

# Where this API is reachable from the outside. Used to build the OAuth
# redirect URI, so it must match what is registered at Google character for
# character.
LUMEN_PUBLIC_URL=http://127.0.0.1:8000

# Where the app front end lives. Used for CORS and for the links in the
# verification and password-reset emails.
LUMEN_APP_URL=http://127.0.0.1:8765

# Extra allowed browser origins, comma-separated. LUMEN_APP_URL is always
# allowed, so a normal deployment needs none. Never "*" -- these endpoints are
# credentialed.
# LUMEN_CORS_ORIGINS=

# Cookie domain for the refresh cookie. Empty means host-only, which is the
# safer default and correct unless you serve the app and API on sibling
# subdomains.
# LUMEN_COOKIE_DOMAIN=

# --- security ----------------------------------------------------------------

# Refuse plain HTTP, send HSTS, and mark cookies Secure. Forced on in
# production; the server will not start without it.
LUMEN_REQUIRE_HTTPS=false

# Block unverified accounts from connecting integrations and running the agent.
# Verification emails are sent either way; this decides how much it gates.
LUMEN_REQUIRE_VERIFIED_EMAIL=true

# --- rate limits -------------------------------------------------------------
#
# Attempts per window, per axis. The account axis is what stops a distributed
# brute force that an IP limit alone would miss.
# LUMEN_RL_WINDOW=900          # seconds
# LUMEN_RL_LOGIN_IP=30
# LUMEN_RL_LOGIN_ACCOUNT=8
# LUMEN_RL_SIGNUP_IP=10
# LUMEN_RL_RESET=5
# LUMEN_RL_RESEND=5
